# All inference stays local. No API key is required.
PORT=3178
HOST=127.0.0.1
# Empty downloads the pinned multilingual checkpoint during npm run setup.
# Set an absolute path to reuse an existing checkpoint directory.
LAYA_MODEL_PATH=
# auto: MLX on Apple Silicon; PyTorch CPU elsewhere.
LAYA_BACKEND=auto
LAYA_URL=http://127.0.0.1:3179
