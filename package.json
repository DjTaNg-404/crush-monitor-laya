{
  "name": "crush-monitor-laya",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:live": "node --import tsx scripts/check-live.ts",
    "setup": "node scripts/setup.mjs",
    "export:source": "node scripts/export-source.mjs",
    "laya:serve": "node scripts/laya.mjs serve",
    "laya:lab": "concurrently -k -n model,api \"npm run laya:serve\" \"node --import tsx server/index.ts\"",
    "laya:cases": "node --import tsx scripts/export-laya-cases.ts",
    "laya:evaluate": "node scripts/laya.mjs evaluate",
    "laya:reference": "node scripts/laya.mjs evaluate --backend torch --repeats 1 --output artifacts/laya-torch.json",
    "laya:test": "node scripts/laya.mjs test",
    "laya:report": "node scripts/laya.mjs report",
    "check:product": "node --import tsx scripts/check-product.ts",
    "laya:challenge": "node scripts/laya.mjs challenge"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "license": "MIT",
  "description": "Local conversation analysis with offline Laya inference",
  "engines": {
    "node": ">=22.12.0"
  }
}
